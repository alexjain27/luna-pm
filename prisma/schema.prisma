generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLIENT
}

enum WorkspaceType {
  CLIENT
  COMPANY
}

enum TaskApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskStatusState {
  ACTIVE
  ARCHIVED
}

enum TaskPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum LineItemKind {
  SERVICE
  EXPENSE
  OTHER
}

enum ProjectStatus {
  INTAKE
  PENDING
  ACTIVE
  ARCHIVED
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  role             UserRole  @default(CLIENT)
  workspaceId      String?
  workspace        Workspace? @relation("WorkspaceUsers", fields: [workspaceId], references: [id])
  primaryWorkspace Workspace? @relation("WorkspacePrimaryUser")
  accounts         Account[]
  sessions         Session[]
  messages         ProjectMessage[]
  taskComments     TaskComment[]
  fileUploads      File[]
  commentFiles     TaskCommentFile[]
  approvals        TaskApproval[]
  requestedTasks   Task[]   @relation("TaskRequestor")
  ownedTasks       Task[]   @relation("TaskOwner")
  activityLogs     TaskActivityLog[] @relation("TaskActivityActor")
  defaultRateCents Int?
  timeEntries      TimeEntry[]
  expenses         Expense[]
  projectRates     ProjectMemberRate[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Workspace {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  type          WorkspaceType
  address       String
  primaryUser   User?         @relation("WorkspacePrimaryUser", fields: [primaryUserId], references: [id])
  primaryUserId String?       @unique
  users         User[]        @relation("WorkspaceUsers")
  projects      Project[]
  tasks         Task[]
  folders       Folder[]
  files         File[]
  customFields  WorkspaceCustomField[]
  invoices      Invoice[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Project {
  id                String                  @id @default(cuid())
  workspaceId       String
  workspace         Workspace               @relation(fields: [workspaceId], references: [id])
  name              String
  status            ProjectStatus           @default(INTAKE)
  startDate         DateTime?
  endDate           DateTime?
  description       String?
  lists             List[]
  tasks             Task[]
  folders           Folder[]
  files             File[]
  messages          ProjectMessage[]
  customFieldValues ProjectCustomFieldValue[]
  billable          Boolean                 @default(true)
  hourlyRateCents   Int?
  budgetMinutes     Int?
  memberRates       ProjectMemberRate[]
  timeEntries       TimeEntry[]
  expenses          Expense[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

model WorkspaceCustomField {
  id          String                  @id @default(cuid())
  workspaceId String
  workspace   Workspace               @relation(fields: [workspaceId], references: [id])
  name        String
  type        String
  options     String[]
  order       Int
  values      ProjectCustomFieldValue[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([workspaceId, name])
}

model ProjectCustomFieldValue {
  id            String               @id @default(cuid())
  projectId     String
  project       Project              @relation(fields: [projectId], references: [id])
  customFieldId String
  customField   WorkspaceCustomField @relation(fields: [customFieldId], references: [id])
  value         String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([projectId, customFieldId])
}

model Folder {
  id          String    @id @default(cuid())
  name        String
  parentId    String?
  parent      Folder?   @relation("FolderHierarchy", fields: [parentId], references: [id])
  children    Folder[]  @relation("FolderHierarchy")
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  files       File[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model List {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id])
  name      String
  tasks     ListTask[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model ListTask {
  id     String @id @default(cuid())
  listId String
  taskId String
  list   List   @relation(fields: [listId], references: [id])
  task   Task   @relation(fields: [taskId], references: [id])

  @@unique([listId, taskId])
}

model TaskStatus {
  id        String          @id @default(cuid())
  name      String
  color     String
  order     Int
  state     TaskStatusState @default(ACTIVE)
  isDefault Boolean         @default(false)
  tasks     Task[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Task {
  id               String          @id @default(cuid())
  workspaceId      String
  workspace        Workspace       @relation(fields: [workspaceId], references: [id])
  projectId        String?
  project          Project?        @relation(fields: [projectId], references: [id])
  statusId         String
  status           TaskStatus      @relation(fields: [statusId], references: [id])
  name             String
  description      String?
  requestorId      String?
  requestor        User?           @relation("TaskRequestor", fields: [requestorId], references: [id])
  ownerId          String?
  owner            User?           @relation("TaskOwner", fields: [ownerId], references: [id])
  parentTaskId     String?
  parentTask       Task?           @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks         Task[]          @relation("Subtasks")
  lists            ListTask[]
  startDate        DateTime?
  dueDate          DateTime?
  priority         TaskPriority    @default(NORMAL)
  tags             String[]
  timeEstimate     Int?
  points           Int?
  dependencies     TaskDependency[] @relation("TaskDependencies")
  dependents       TaskDependency[] @relation("TaskDependents")
  requiresApproval Boolean         @default(false)
  approval         TaskApproval?
  comments         TaskComment[]
  files            TaskFile[]
  activityLogs     TaskActivityLog[]
  timeEntries      TimeEntry[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model TaskActivityLog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  actorId   String
  actor     User     @relation("TaskActivityActor", fields: [actorId], references: [id])
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
}

model TaskDependency {
  id          String @id @default(cuid())
  taskId      String
  dependsOnId String
  task        Task   @relation("TaskDependencies", fields: [taskId], references: [id])
  dependsOn   Task   @relation("TaskDependents", fields: [dependsOnId], references: [id])

  @@unique([taskId, dependsOnId])
}

model TaskApproval {
  id          String             @id @default(cuid())
  taskId      String             @unique
  task        Task               @relation(fields: [taskId], references: [id])
  status      TaskApprovalStatus @default(PENDING)
  decidedById String?
  decidedBy   User?              @relation(fields: [decidedById], references: [id])
  decidedAt   DateTime?
  note        String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model TaskComment {
  id              String            @id @default(cuid())
  taskId          String
  task            Task              @relation(fields: [taskId], references: [id])
  authorId        String
  author          User              @relation(fields: [authorId], references: [id])
  body            String
  parentCommentId String?
  parentComment   TaskComment?      @relation("CommentThread", fields: [parentCommentId], references: [id])
  replies         TaskComment[]     @relation("CommentThread")
  files           TaskCommentFile[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model TaskCommentFile {
  id            String      @id @default(cuid())
  taskCommentId String
  taskComment   TaskComment @relation(fields: [taskCommentId], references: [id])
  uploaderId    String
  uploader      User        @relation(fields: [uploaderId], references: [id])
  filename      String
  s3Key         String
  size          Int
  mimeType      String
  createdAt     DateTime    @default(now())
}

model ProjectMessage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model File {
  id          String    @id @default(cuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  folderId    String?
  folder      Folder?   @relation(fields: [folderId], references: [id])
  uploaderId  String
  uploader    User      @relation(fields: [uploaderId], references: [id])
  filename    String
  s3Key       String
  size        Int
  mimeType    String
  tasks       TaskFile[]
  createdAt   DateTime  @default(now())
}

model TaskFile {
  id     String @id @default(cuid())
  taskId String
  fileId String
  task   Task   @relation(fields: [taskId], references: [id])
  file   File   @relation(fields: [fileId], references: [id])

  @@unique([taskId, fileId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Time tracking, expenses & invoicing (docs/time-billing.md) ──

model BillingSettings {
  id                String   @id @default("default")
  companyName       String   @default("Luna PM")
  companyAddress    String?
  currency          String   @default("USD")
  invoicePrefix     String   @default("INV-")
  nextInvoiceNumber Int      @default(1001)
  defaultTaxRate    Float    @default(0)
  paymentTermsDays  Int      @default(30)
  invoiceNotes      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ProjectMemberRate {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hourlyRateCents Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, userId])
}

model TimeEntry {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id])
  taskId         String?
  task           Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  date           DateTime  @db.Date
  minutes        Int       @default(0)
  notes          String?
  billable       Boolean   @default(true)
  rateCents      Int       @default(0)
  timerStartedAt DateTime?
  invoiceId      String?
  invoice        Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, date])
  @@index([projectId, date])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Expense {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id])
  categoryId      String
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  date            DateTime        @db.Date
  amountCents     Int
  notes           String?
  billable        Boolean         @default(true)
  receiptS3Key    String?
  receiptFilename String?
  invoiceId       String?
  invoice         Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([projectId, date])
}

model Invoice {
  id          String            @id @default(cuid())
  number      String            @unique
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  status      InvoiceStatus     @default(DRAFT)
  subject     String?
  issueDate   DateTime          @db.Date
  dueDate     DateTime          @db.Date
  periodStart DateTime?         @db.Date
  periodEnd   DateTime?         @db.Date
  taxRate     Float             @default(0)
  notes       String?
  sentAt      DateTime?
  paidAt      DateTime?
  lineItems   InvoiceLineItem[]
  timeEntries TimeEntry[]
  expenses    Expense[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model InvoiceLineItem {
  id             String       @id @default(cuid())
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind           LineItemKind @default(OTHER)
  description    String
  quantity       Float
  unitPriceCents Int
  amountCents    Int
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}
